<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Passkeys and invite links on the Switchboard domain (passkey-domain/ serves apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:switchboard.applabs.llc</string>
		<string>applinks:switchboard.applabs.llc</string>
	</array>
</dict>
</plist>
