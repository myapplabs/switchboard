{
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "target": "switchboard",
    "rewrites": [
      {
        "source": "/join",
        "destination": "/join.html"
      },
      {
        "source": "/pair",
        "destination": "/pair.html"
      }
    ]
  }
}
