{
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/install.sh",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      }
    ],
    "target": "switchboard",
    "rewrites": [
      {
        "source": "/join",
        "destination": "/join.html"
      },
      {
        "source": "/pair",
        "destination": "/pair.html"
      }
    ],
    "predeploy": [
      "cp \"$PROJECT_DIR/../install.sh\" \"$PROJECT_DIR/public/install.sh\""
    ]
  }
}
